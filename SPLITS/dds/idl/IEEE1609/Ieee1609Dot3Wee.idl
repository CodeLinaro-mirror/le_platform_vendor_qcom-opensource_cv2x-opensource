struct Latitude
{
    octet fill;
    long long lat;
};

struct TwoDLocation
{
    Latitude latitude;
    Longitude longitude;
};

struct ThreeDLocation
{
    Latitude latitude;
    Longitude longitude;
    Elevation elevation;
};

enum multiplier
{
    bytes,
    kb,
    mb,
    gb
};
struct MaxDataRateBytesPerSec
{
    unsigned short number;
    multiplier multi;
};

enum MinimumTrafficPeriodicity
{
  sf20, sf50, sf100, sf200, sf300, sf400, sf500,
  sf600, sf700, sf800, sf900, sf1000
};

struct LTEv2xChannelInfo
{
  @optional ARFCN_ValueEUTRA_r9 txPoolEarfcn;
  @optional P_Max pMax;
  @optional SL_Priority_r13 pppp;
  @optional SL_TxPoolIdentity_r12 txPool;
  @optional octet minMcs;
  @optional octet maxMcs;
  @optional unsigned short minPdb;
  @optional unsigned short mtu;
  @optional MaxDataRateBytesPerSec maxDataRate;
  @optional MinimumTrafficPeriodicity minPeriodicity;
  @optional octet maxSpeed;
  @optional unsigned short maxRange;
  @optional octet maxCbr;

  /*@optional preconfigInfo   SL_V2X_Preconfiguration_r14 OPTIONAL, */

};

//AssertedBySASigner ::= NULL
struct ProviderServiceContext
{
    octet fillbit;
    octet psc[32];
};

struct EdcaParameterRecord
{
    octet res;
    octet aci;
    octet acm;
    octet aifsn;
    octet ecwMax;
    octet ecwMin;
    unsigned short txopLimi;
};

struct EdcaParameterSet
{
    EdcaParameterRecord acbeRecord;
    EdcaParameterRecord acbkRecord;
    EdcaParameterRecord acviRecord;
    EdcaParameterRecord acvoRecord;
};


};
};
