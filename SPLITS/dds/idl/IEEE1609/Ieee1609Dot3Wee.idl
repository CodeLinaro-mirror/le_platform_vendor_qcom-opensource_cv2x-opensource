module IEEE1609Dot3 {
module idl{

/* Extracted from 3GPP TS 36.331 i20 */
typedef char P_Max;
typedef octet SL_Priority_r13;
typedef octet SL_TxPoolIdentity_r12;
typedef long ARFCN_ValueEUTRA_r9; 
/*ARFCN-ValueEUTRA-r9 ::=				INTEGER (0..262143)*/

/* intergers typedefs */
typedef octet DataRate80211; //::= INTEGER (0..255)

typedef char TXpower80211; //::= INTEGER (-128..127)

typedef octet ChannelNumber80211; //::= INTEGER (0..255)

typedef octet CompactTimeConfidence; //::= INTEGER (0..255)

typedef octet RepeatRate; //::= INTEGER (0..255)

typedef octet IPv6Address[16]; // ::= OCTET STRING (SIZE (16))
typedef IPv6Address SecondaryDns;

typedef unsigned short ServicePort; //::= INTEGER (0..65535)


typedef octet MACaddress[6];
typedef MACaddress GatewayMacAddress ;
typedef MACaddress ProviderMacAddress;

typedef octet RcpiThreshold; // ::= INTEGER (0..255) -- see IEEE Std 802.11

typedef octet WsaCountThreshold; // ::= INTEGER (0..255)

typedef octet WsaCountThresholdInterval; //::= INTEGER (0..255) -- value 0 is not used
typedef long long Longitude; //::= INTEGER (-1799999999..1800000001)

typedef long Elevation; //::= INTEGER (-4096..61439)

typedef sequence<octet, 4> VarLengthNumber;

typedef octet ChannelAccess80211;
typedef string AdvertiserIdentifier; // ::= UTF8String (SIZE (1..32))


typedef VarLengthNumber ProtocolType;

typedef sequence<octet, 128> ApplicationData;

