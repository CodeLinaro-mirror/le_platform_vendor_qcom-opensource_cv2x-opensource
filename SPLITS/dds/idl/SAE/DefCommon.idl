/* 
 * This idl defines the common definations of SAE and CSAE data types.
 */

#ifndef DEF_COMMON_
#define DEF_COMMON_


module J2735 {
module idl {

// same definition as in MsgFrame.asn
typedef octet MsgCount;

// same definitions as in DefAcceleration.asn
typedef short Acceleration;
typedef char VerticalAcceleration;
typedef short YawRate;

// same definitions as in VehSize.asn
typedef unsigned short VehicleWidth;
typedef unsigned short VehicleLength;
typedef octet VehicleHeight;

// same definitions as in DefPosition.asn
typedef long Latitude;
typedef long Longitude;
typedef long Elevation;
typedef octet SemiMajorAxisAccuracy;
typedef octet SemiMinorAxisAccuracy;
typedef unsigned short SemiMajorAxisOrientation;
enum ElevationConfidence {
   elev_unavailable, /* (0),  $$ B'0000  Not Equipped or unavailable */
   elev_500_00, /* (1),  $$ B'0001  (500 m) */
   elev_200_00, /* (2),  $$ B'0010  (200 m) */
   elev_100_00, /*(3),  $$ B'0011  (100 m) */
   elev_050_00, /*(4),  $$ B'0100  (50 m) */
   elev_020_00, /*(5),  $$ B'0101  (20 m) */
   elev_010_00, /*(6),  $$ B'0110  (10 m) */
   elev_005_00, /*(7),  $$ B'0111  (5 m) */
   elev_002_00, /*(8),  $$ B'1000  (2 m) */
   elev_001_00, /*(9),  $$ B'1001  (1 m) */
   elev_000_50, /*(10), $$ B'1010  (50 cm) */
   elev_000_20, /*(11), $$ B'1011  (20 cm) */
   elev_000_10, /*(12), $$ B'1100  (10 cm) */
   elev_000_05, /*(13), $$ B'1101  (5 cm) */
   elev_000_02, /*(14), $$ B'1110  (2 cm) */
   elev_000_01 /*(15)  $$ B'1111  (1 cm) */
};

// same definitions as in DefTime.asn
typedef unsigned short TimeMark;
typedef unsigned long MinuteOfTheYear;
typedef unsigned short DSecond;
typedef unsigned short DYear;
typedef octet DMonth;
typedef octet DDay;
typedef octet DHour;
typedef octet DMinute;
/* units of minutes from UTC time, same to DTimeOffset in CSAE */
typedef short DOffset;
/*
   -- LSB units of of 10 mSec, 
   -- with a range of 0.01 seconds to 10 minutes and 55.34 seconds
   -- a value of 65534 to be used for 655.34 seconds or greater
   -- a value of 65535 to be unavailable
*/
typedef unsigned short TimeOffset;
struct DDateTime
{
    @optional DYear year;
    @optional DMonth month;
    @optional DDay day;
    @optional DHour hour;
    @optional DMinute minute;
    @optional DSecond second;
    @optional DOffset offset;
};

// same definitions as in DefMotion.asn
typedef unsigned short Speed;
typedef unsigned short Heading;
typedef char SteeringWheelAngle;
typedef octet CoarseHeading;

// same definitions as in VehClass.asn
typedef octet BasicVehicleClass;
typedef octet FuelType;

// same definitions as in DefPositionOffset.asn
typedef short OffsetLL_B12;
typedef short OffsetLL_B14;
typedef short OffsetLL_B16;
typedef long OffsetLL_B18;
typedef long OffsetLL_B22;
typedef long OffsetLL_B24;
typedef char VertOffset_B07;
typedef char VertOffset_B08;
typedef short VertOffset_B09;
typedef short VertOffset_B10;
typedef short VertOffset_B11;
typedef short VertOffset_B12;

// same definitions as in VehSafetyExt.asn
typedef short RadiusOfCurvature;
typedef octet Confidence;

// same definitions as in VehSafetyExt.asn
@bit_bound(8)
bitmask GNSSstatus {
    @position(0) gnss_unavailable,
    @position(1) isHealthy,
    @position(2) isMonitored,
    @position(3) baseStationType,
    @position(4) aPDOPofUnder5,
    @position(5) inViewOfUnder5,
    @position(6) localCorrectionsPresent,
    @position(7) networkCorrectionsPresent
};

// same definitions as in VehSafetyExt.asn
struct PathPrediction {
    RadiusOfCurvature radiusOfCurve;
    Confidence confidence;
};

// same definitions as in DefMotion.asn
enum HeadingConfidence {
   hc_unavailable,   /*(0), $$ B'000  Not Equipped or unavailable */
   prec10deg,     /*(1), $$ B'010  10     degrees */
   prec05deg,     /*(2), $$ B'011  5      degrees */
   prec01deg,     /*(3), $$ B'100  1      degrees */
   prec0_1deg,    /*(4), $$ B'101  0.1    degrees */
   prec0_05deg,   /*(5), $$ B'110  0.05   degrees */
   prec0_01deg,   /*(6), $$ B'110  0.01   degrees */
   prec0_0125deg /*(7)  $$ B'111  0.0125 degrees, aligned with heading LSB */
};

// same definitions as in DefMotion.asn
enum SpeedConfidence {
   sc_unavailable , /*(0), $$ Not Equipped or unavailable */
   prec100ms   , /*(1), $$ 100  meters / sec */
   prec10ms    , /*(2), $$ 10   meters / sec */
   prec5ms     , /*(3), $$ 5    meters / sec */
   prec1ms     , /*(4), $$ 1    meters / sec */
   prec0_1ms   , /*(5), $$ 0.1  meters / sec */
   prec0_05ms  , /*(6), $$ 0.05 meters / sec */
   prec0_01ms   /*(7)  $$ 0.01 meters / sec */
};

// same definitions as in DefMotion.asn
enum SteeringWheelAngleConfidence {
    swac_unavailable,
    prec2deg,
    prec1deg,
    prec0_02deg
};

// same definitions as in VehStatus.asn
enum TransmissionState {
   neutral,      /*(0), $$ Neutral */
   park,         /*(1), $$ Park */
   forwardGears, /*(2), $$ Forward gears */
   reverseGears, /*(3), $$ Reverse gears */
   ts_reserved1,    /*(4), */
   ts_reserved2,    /*(5), */
   ts_reserved3,    /*(6),*/
   trans_unavailable   /*(7)  $$ not-equipped or unavailable value,
   $$ Any related speed is relative to the vehicle reference frame used */
};

// same definitions as in DefTime.asn
enum TimeConfidence {
   tc_unavailable              ,/*0), $$ Not Equipped or unavailable */
   time_100_000             ,/*1), $$ Better than  100 seconds */
   time_050_000             ,/*2), $$ Better than  50 seconds */
   time_020_000             ,/*3), $$ Better than  20 seconds */
   time_010_000             ,/*4), $$ Better than  10 seconds */
   time_002_000             ,/*5), $$ Better than  2 seconds */
   time_001_000             ,/*6), $$ Better than  1 Second */
   time_000_500             ,/*7), $$ Better than  0.5 seconds */
   time_000_200             ,/*8), $$ Better than  0.2 seconds */
   time_000_100             ,/*9), $$ Better than  0.1 seconds */
   time_000_050            ,/*10), $$ Better than  0.05 seconds */
   time_000_020            ,/*11), $$ Better than  0.02 seconds */
   time_000_010            ,/*12), $$ Better than  0.01 seconds */
   time_000_005            ,/*13), $$ Better than  0.005 seconds */
   time_000_002            ,/*14), $$ Better than  0.002 seconds */
   time_000_001            ,/*15), $$ Better than  0.001 seconds 
                                 $$ Better than  1 ms */
   time_000_000_5          ,/*16), $$ Better than  0.000,5 seconds */
   time_000_000_2          ,/*17), $$ Better than  0.000,2 seconds */
   time_000_000_1          ,/*18), $$ Better than  0.000,1 seconds */
   time_000_000_05         ,/*19), $$ Better than  0.000,05 seconds */
   time_000_000_02         ,/*20), $$ Better than  0.000,02 seconds */
   time_000_000_01         ,/*21), $$ Better than  0.000,01 seconds */
   time_000_000_005        ,/*22), $$ Better than  0.000,005 seconds */
   time_000_000_002        ,/*23), $$ Better than  0.000,002 seconds */
   time_000_000_001        ,/*24), $$ Better than  0.000,001 seconds 
                                 $$ Better than  1 µs */
   time_000_000_000_5      ,/*25), $$ Better than  0.000,000,5 seconds */
   time_000_000_000_2      ,/*26), $$ Better than  0.000,000,2 seconds */
   time_000_000_000_1      ,/*27), $$ Better than  0.000,000,1 seconds */
   time_000_000_000_05     ,/*28), $$ Better than  0.000,000,05 seconds */
   time_000_000_000_02     ,/*29), $$ Better than  0.000,000,02 seconds */
   time_000_000_000_01     ,/*30), $$ Better than  0.000,000,01 seconds */
   time_000_000_000_005    ,/*31), $$ Better than  0.000,000,005 seconds */
   time_000_000_000_002    ,/*32), $$ Better than  0.000,000,002 seconds */
   time_000_000_000_001    ,/*33), $$ Better than  0.000,000,001 seconds 
                                 $$ Better than  1 nanosecond */
   time_000_000_000_000_5  ,/*34), $$ Better than  0.000,000,000,5 seconds */
   time_000_000_000_000_2  ,/*35), $$ Better than  0.000,000,000,2 seconds */
   time_000_000_000_000_1  ,/*36), $$ Better than  0.000,000,000,1 seconds */
   time_000_000_000_000_05 ,/*37), $$ Better than  0.000,000,000,05 seconds */
   time_000_000_000_000_02 ,/*38), $$ Better than  0.000,000,000,02 seconds */
   time_000_000_000_000_01 /*39)  $$ Better than  0.000,000,000,01 seconds */ 
};

// same definitions as in DefTime.asn
@bit_bound(9)
bitmask ExteriorLights {
    @position(0) lowBeamHeadlightsOn,
    @position(1) highBeamHeadlightsOn,
    @position(2) leftTurnSignalOn,
    @position(3) rightTurnSignalOn,
    @position(4) hazardSignalOn,
    @position(5) automaticLightControlOn,
    @position(6) daytimeRunningLightsOn,
    @position(7) fogLightOn,
    @position(8) parkingLightsOn
};

// same definitions as in DefPosition.asn
enum PositionConfidence {
   pc_unavailable , /*(0),  $$ B'0000  Not Equipped or unavailable */
   a500m   , /*(1), $$ B'0001  500m  or about 5 * 10 ^ _3 decimal degrees */
   a200m   , /*(2), $$ B'0010  200m  or about 2 * 10 ^ _3 decimal degrees */
   a100m   , /*(3), $$ B'0011  100m  or about 1 * 10 ^ _3 decimal degrees */
   a50m    , /*(4), $$ B'0100  50m   or about 5 * 10 ^ _4 decimal degrees */ 
   a20m    , /*(5), $$ B'0101  20m   or about 2 * 10 ^ _4 decimal degrees */ 
   a10m    , /*(6), $$ B'0110  10m   or about 1 * 10 ^ _4 decimal degrees */ 
   a5m     , /*(7), $$ B'0111  5m    or about 5 * 10 ^ _5 decimal degrees */ 
   a2m     , /*(8), $$ B'1000  2m    or about 2 * 10 ^ _5 decimal degrees */ 
   a1m     , /*(9), $$ B'1001  1m    or about 1 * 10 ^ _5 decimal degrees */ 
   a50cm  , /*(10), $$ B'1010  0.50m or about 5 * 10 ^ _6 decimal degrees */ 
   a20cm  , /*(11), $$ B'1011  0.20m or about 2 * 10 ^ _6 decimal degrees */ 
   a10cm  , /*(12), $$ B'1100  0.10m or about 1 * 10 ^ _6 decimal degrees */ 
   a5cm   , /*(13), $$ B'1101  0.05m or about 5 * 10 ^ _7 decimal degrees */ 
   a2cm   , /*(14), $$ B'1110  0.02m or about 2 * 10 ^ _7 decimal degrees */ 
   a1cm    /*(15)  $$ B'1111  0.01m or about 1 * 10 ^ _7 decimal degrees */ 
};

// same definitions as in VehEmgExt.asn
enum ResponseType {
   notInUseOrNotEquipped,      /*(0),             */
   rt_emergency,                  /*(1),  $$ active service call at emergency level           */
   nonEmergency ,              /*(2),  $$ also used when returning from service call       */
   pursuit,                    /*(3),  $$ sender driving may be erratic  */
   stationary,                 /*(4),  $$ sender is not moving, stopped along roadside */
   rt_slowMoving,                 /*(5),  $$ such a mowers, litter trucks, etc. */
   stopAndGoMovement           /*(6),  $$ such as school bus or garbage truck */
};

// same definitions as in VehEmgExt.asn
enum SirenInUse {
    siren_unavailable,   /*(0), $$ Not Equipped or unavailable */
    siren_notInUse,      /*(1), */
    siren_inUse,         /*(2), */
    siren_reserved       /*(3)  $$ for future use */
};

// same definitions as in VehEmgExt.asn
enum LightbarInUse {
    lb_unavailable,         /*(0),  $$ Not Equipped or unavailable */
    lb_notInUse,            /*(1),  $$ none active */
    lb_inUse,               /*(2),   */
    yellowCautionLights, /*(3),   */
    schooldBusLights,    /*(4),   */
    arrowSignsActive,    /*(5),   */
    slowMovingVehicle,   /*(6),    */
    freqStops            /*(7)    */
};

// same definitions as in DefPosition.asn
struct PositionalAccuracy {
    SemiMajorAxisAccuracy semiMajor;
    SemiMinorAxisAccuracy semiMinor;
    SemiMajorAxisOrientation orientation;
};

// same definitions as in DefAcceleration.asn
struct AccelerationSet4Way {
    Acceleration longitude;
    Acceleration lat;
    VerticalAcceleration vert;
    YawRate yaw;
};

// same definitions as in VehBrake.asn
@bit_bound(5)
bitmask BrakeAppliedStatus {
    @position(0) unavailable_b,
    @position(1) leftFront_b,
    @position(2) leftRear_b,
    @position(3) rightFront_b,
    @position(4) rightRear_b
};

// same definitions as in VehBrake.asn
enum TractionControlStatus {
    tcs_unavailable, /*(0), $$ B'00  Not Equipped with traction control 
                     $$       or traction control status is unavailable */
    tcs_off,         /*(1), /*$$ B'01  traction control is Off*/
    tcs_on,          /*(2), /*$$ B'10  traction control is On (but not Engaged) */
    tcs_engaged      /*(3)  $$ B'11  traction control is Engaged*/
};

// same definitions as in VehBrake.asn
enum AntiLockBrakeStatus {
    abs_unavailable, /* (0), $ B'00  Vehicle Not Equipped with ABS Brakes */
                     /*      $$       or ABS Brakes status is unavailable */
    abs_off,         /* (1), $$ B'01  Vehicle's ABS are Off */
    abs_on,          /* (2), $$ B'10  Vehicle's ABS are On ( but not Engaged ) */
    abs_engaged      /* (3)  $$ B'11  Vehicle's ABS control is Engaged on any wheel */
};

// same definitions as in VehBrake.asn
enum StabilityControlStatus {
    scs_unavailable, /* (0)$$ B'00  Not Equipped with SC
                        $$       or SC status is unavailable */
    scs_off,         /*(1), /*$$ B'01  Off */
    scs_on,          /*(2), $$ B'10  On or active (but not engaged) */
    scs_engaged      /*(3)  $$ B'11  stability control is Engaged */
};

// same definitions as in VehBrake.asn
enum BrakeBoostApplied
{
    bba_unavailable,
    bba_off,
    bba_on
};

// same definitions as in VehBrake.asn
enum AuxiliaryBrakeStatus {
    auxbs_unavailable,
    auxbs_off,
    auxbs_on,
    auxbs_reserved
};

// same definition as in MapNode.asn
typedef string DescriptiveName;
typedef unsigned short RoadRegulatorID;

// same definition as in MapSpeedLimit.asn
typedef unsigned short Velocity; /* Same definition as Speed in NTCAS */
enum SpeedLimitType {
    slt_unknown,                    /*-- Speed limit type not available*/
    maxSpeedInSchoolZone,       /*-- Only sent when the limit is active*/
    maxSpeedInSchoolZoneWhenChildrenArePresent, /*-- Sent at any time*/
    maxSpeedInConstructionZone, /*-- Used for work zones, incident zones, etc.*/
                                /*-- where a reduced speed is present*/
    vehicleMinSpeed,
    vehicleMaxSpeed,            /*-- Regulatory speed limit for general traffic*/
    vehicleNightMaxSpeed,

    truckMinSpeed,
    truckMaxSpeed,
    truckNightMaxSpeed,

    vehiclesWithTrailersMinSpeed,
    vehiclesWithTrailersMaxSpeed,
    vehiclesWithTrailersNightMaxSpeed
};

struct RegulatorySpeedLimit {
    SpeedLimitType type;
    Velocity speed;
};
typedef sequence<RegulatorySpeedLimit, 9> SpeedLimitList;

// same definition as in MapLane.asn
typedef unsigned short LaneWidth;
typedef octet LaneID;


@bit_bound(16)
bitmask LaneAttributes_Barrier
{
    @position(0)	median_RevocableLane,
    @position(1)	median,
    @position(2)	whiteLineHashing,
    @position(3)	stripedLines,
    @position(4)	doubleStripedLines,
    @position(5)	trafficCones,
    @position(6)	constructionBarrier,
    @position(7)	trafficChannels,
    @position(8)	lowCurbs,
    @position(9)	highCurbs
};
@bit_bound(16)
bitmask LaneAttributes_Bike
{
    @position(0)	lab_bikeRevocableLane,
    @position(1)	lab_pedestrianUseAllowed,
    @position(2)	lab_isBikeFlyOverLane,
    @position(3)	lab_fixedCycleTime,
    @position(4)	lab_biDirectionalCycleTimes,
    @position(5)	lab_isolatedByBarrier,
    @position(6)	lab_unsignalizedSegmentsPresent
};
@bit_bound(16)
bitmask LaneAttributes_Crosswalk
{
    @position(0)	lac_crosswalkRevocableLane,
    @position(1)	lac_bicyleUseAllowed,
    @position(2)	lac_isXwalkFlyOverLane,
    @position(3)	lac_fixedCycleTime,
    @position(4)	lac_biDirectionalCycleTimes,
    @position(5)	lac_hasPushToWalkButton,
    @position(6)	lac_audioSupport,
    @position(7)	lac_rfSignalRequestPresent,
    @position(8)	lac_unsignalizedSegmentsPresent
};
@bit_bound(16)
bitmask LaneAttributes_Parking
{
    @position(0) lap_parkingRevocableLane,
    @position(1) lap_parallelParkingInUse,
    @position(2) lap_headInParkingInUse,
    @position(3) lap_doNotParkZone,
    @position(4) lap_parkingForBusUse,
    @position(5) lap_parkingForTaxiUse,
    @position(6) lap_noPublicParkingUse
};

@bit_bound(16)
bitmask LaneAttributes_Sidewalk
{
   @position(0) las_sidewalk_RevocableLane,
   @position(1) las_bicyleUseAllowed,
   @position(2) las_isSidewalkFlyOverLane,
   @position(3) las_walkBikes
};

@bit_bound(16)
bitmask LaneAttributes_Striping
{
    @position(0) stripeToConnectingLanesRevocableLane,
    @position(1) stripeDrawOnLeft,
    @position(2) stripeDrawOnRight,
    @position(3) stripeToConnectingLanesLeft,
    @position(4) stripeToConnectingLanesRight,
    @position(5) stripeToConnectingLanesAhead
};

@bit_bound(16)
bitmask LaneAttributes_TrackedVehicle
{
   @position(0) spec_RevocableLane,
   @position(1) spec_commuterRailRoadTrack,
   @position(2) spec_lightRailRoadTrack,
   @position(3) spec_heavyRailRoadTrack,
   @position(4) spec_otherRailType
};

@bit_bound(16)
bitmask LaneAttributes_Vehicle
{
    @position(0)	isVehicleRevocableLane,
    @position(1)	isVehicleFlyOverLane,
    @position(2)	hovLaneUseOnly,
    @position(3)	restrictedToBusUse,
    @position(4)	restrictedToTaxiUse,
    @position(5)	restrictedFromPublicUse,
    @position(6)	hasIRbeaconCoverage,
    @position(7)	permissionOnRequest
};

union LaneTypeAttributes switch(octet) {
case 0:
   LaneAttributes_Vehicle vehicle;
case 1:
   LaneAttributes_Crosswalk crosswalk;
case 2:
   LaneAttributes_Bike bikeLane;
case 3:
   LaneAttributes_Sidewalk sidewalk;
case 4:
   LaneAttributes_Barrier median;
case 5:
   LaneAttributes_Striping striping;
case 6:
   LaneAttributes_TrackedVehicle trackedVehicle;
case 7:
   LaneAttributes_Parking parking;
};

@bit_bound(10)
bitmask LaneSharing {
    @position(0)	overlappingLaneDescriptionProvided,
    @position(1)	multipleLanesTreatedAsOneLane,
    @position(2)	otherNonMotorizedTrafficTypes,
    @position(3)	individualMotorizedVehicleTraffic,
    @position(4)	busVehicleTraffic,
    @position(5)	taxiVehicleTraffic,
    @position(6)	pedestriansTraffic,
    @position(7)	cyclistVehicleTraffic,
    @position(8)	trackedVehicleTraffic,
    @position(9)	reserved
};

// same definition as in SPATIntersectionState
@bit_bound(16)
bitmask IntersectionStatusObject {
    @position(0)	manualControlIsEnabled,
    @position(1)	stopTimeIsActivated,
    @position(2)	failureFlash,
    @position(3)	preemptIsActive,
    @position(4)	signalPriorityIsActive,
    @position(5)	fixedTimeOperation,
    @position(6)	trafficDependentOperation,
    @position(7)	standbyOperation,
    @position(8)	failureMode,
    @position(9)	off,
    @position(10) recentMAPmessageUpdate,
    @position(11) recentChangeInMAPassignedLanesIDsUsed,
    @position(12) noValidMAPisAvailableAtThisTime,
    @position(13) noValidSPATisAvailableAtThisTime
};

// same definition as in RSI.asn
typedef unsigned short Radius;


};
};
#endif
