/* 
 * This idl defines CSAE data types included in MapLane.asn
 */

#ifndef MAP_LANE_
#define MAP_LANE_

#include "DefCommon.idl"
#include "MapNode.idl"
#include "MapPoint.idl"
#include "SPATIntersectionState.idl"

module Csae {
module idl {

struct LaneAttributes {
    @optional J2735::idl::LaneSharing shareWith;
    J2735::idl::LaneTypeAttributes laneType;
};

struct Connection {
    NodeReferenceID remoteIntersection;
    @optional J2735::idl::ConnectingLane connectingLane;
    @optional PhaseID phaseId;
};

typedef sequence<Connection, 8> ConnectsToList;

struct Lane {
    J2735::idl::LaneID laneID;
    @optional J2735::idl::LaneWidth laneWidth;
    @optional LaneAttributes laneAttributes;
    @optional J2735::idl::AllowedManeuvers maneuvers;
    @optional ConnectsToList connectsTo;
    @optional J2735::idl::SpeedLimitList speedLimits;
    @optional PointList points;
};
typedef sequence<Lane, 32> LaneList;
};
};

#endif
