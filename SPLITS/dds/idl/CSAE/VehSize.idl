/* 
 * This idl defines CSAE data types included in VehSize.asn
 */
#ifndef VEH_SIZE_
#define VEH_SIZE_

#include "DefCommon.idl"

module Csae {
module idl {

struct VehicleSize {
    J2735::idl::VehicleWidth width;
    J2735::idl::VehicleLength length;
    @optional J2735::idl::VehicleHeight height;
};
};
};
#endif
