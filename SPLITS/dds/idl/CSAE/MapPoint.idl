/* 
 * This idl defines CSAE data types included in MapPoint.asn
 */

#ifndef MAP_POINT_
#define MAP_POINT_

#include "DefCommon.idl"

#include "DefPositionOffset.idl"

module Csae {
module idl {

struct RoadPoint {
    PositionOffsetLLV posOffset; // Position offset to the reference position
};

/*
	-- At least 2 points of 1 lane
	-- entry line and exit line
	-- points need to be listed sequentially
	-- from upstream to downstream
*/
typedef sequence<RoadPoint, 31> PointList;
};
};

#endif
