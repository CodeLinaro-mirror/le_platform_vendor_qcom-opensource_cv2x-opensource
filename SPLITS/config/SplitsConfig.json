                //0: Local, message is generated inside SPLITS (BSM is the case)
                //1: Remote, message is generated on remote side (EAP), sent to SPLITS via DDS
                "Source" : 0,
                //Format: specify the format if the source is 1(Remote)
                //0 : BLOB , message is encoded/signed and has WSMP header.
                //1 : SIGNED, message is encoded and signed, but no WSMP header.
                //2 : UNSIGNED, message is encoded, but not signed and no WSMP header.
                //3 : unencoded, message is in fast dds IDL format, unencoded.
                "Format" : 3,
                "Periodicity" : 100,
                "SourcePort" : 9000,
                "DestPort" : 2500,
