package commonapi.telux.cv2x
import commonapi.telux.common.* from "common.fidl"
import commonapi.telux.cv2x.* from "Cv2xRadioTypes.fidl"

interface Cv2xRadioManager extends Cv2xRadioTypes {

    version { major 1 minor 0 }

    broadcast cv2xStatusEx {
        out {
            commonapi.telux.cv2x.Cv2xRadioTypes.Cv2xStatusEx statusEx
        }
    }

    method GetServiceStatus {
        out {
            commonapi.telux.common.CommonDefines.ServiceStatus status
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method startCv2x {
        out {
            commonapi.telux.common.CommonDefines.Status status
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }
    method stopCv2x {
        out {
            commonapi.telux.common.CommonDefines.Status status
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method requestCv2xStatus {
        out {
            commonapi.telux.cv2x.Cv2xRadioTypes.Cv2xStatus status
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method requestCv2xStatusEx {
        out {
            commonapi.telux.cv2x.Cv2xRadioTypes.Cv2xStatusEx statusEx
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method setPeakTxPower {
        in {
            Int8 txPower
        }
        out {
            commonapi.telux.common.CommonDefines.Status status
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method setL2Filters {
        in {
            L2FilterInfo[] filterList
        }
        out {
            commonapi.telux.common.CommonDefines.Status status
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method removeL2Filters {
        in {
            UInt32[] l2IdList
        }
        out {
            commonapi.telux.common.CommonDefines.Status status
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method getSlssRxInfo {
        out {
            commonapi.telux.cv2x.Cv2xRadioTypes.SlssRxInfo slssRxInfo
            commonapi.telux.common.CommonDefines.Status status
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method injectCoarseUtcTime {
        in {
            UInt64 utc
        }
        out {
            commonapi.telux.common.CommonDefines.Status status
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }
}
