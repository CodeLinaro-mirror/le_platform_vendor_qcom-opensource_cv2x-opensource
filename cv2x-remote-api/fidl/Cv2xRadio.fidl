package commonapi.telux.cv2x
import commonapi.telux.common.* from "common.fidl"
import commonapi.telux.cv2x.* from "Cv2xRadioTypes.fidl"

interface Cv2xRadio extends Cv2xRadioTypes {
    version {major 1 minor 0 }

    method createRxSubscription {
        in {
            commonapi.telux.cv2x.Cv2xRadioTypes.TrafficIpType ipType
            UInt16 port
            UInt32[] idList
        }
        out {
            UInt32 subscriptionId
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method getServiceStatus {
        out {
            commonapi.telux.common.CommonDefines.ServiceStatus status
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method enableRxMetaDataReport {
        in {
            commonapi.telux.cv2x.Cv2xRadioTypes.TrafficIpType ipType
            Boolean enable
            UInt32[] idList
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method createTxSpsFlow {
        in {
            commonapi.telux.cv2x.Cv2xRadioTypes.TrafficIpType ipType
            UInt32 serviceId
            commonapi.telux.cv2x.Cv2xRadioTypes.SpsFlowInfo spsInfo
            UInt16 spsSrcPort
            Boolean eventSrcPortValid
            UInt16 eventSrcPort
        }
        out {
            UInt32 txSpsFlowId
            UInt32 txEventFlowId
            commonapi.telux.common.CommonDefines.ErrorCode spsError
            commonapi.telux.common.CommonDefines.ErrorCode eventError
        }
        error commonapi.telux.common.CommonDefines.ErrorCode

    }

    method createTxEventFlow {
        in {
            commonapi.telux.cv2x.Cv2xRadioTypes.TrafficIpType ipTyp
            UInt32 serviceId
            commonapi.telux.cv2x.Cv2xRadioTypes.EventFlowInfo flowInfo
            UInt16 eventSrcPort
        }
        out {
            UInt32 txEventFlowId
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method closeRxSubscription {
        in {
            UInt32 subscriptionId
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method closeTxFlow {
        in {
            UInt32 txFlowId
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method changeSpsFlowInfo {
        in {
            UInt32 txFlowId
            commonapi.telux.cv2x.Cv2xRadioTypes.SpsFlowInfo spsInfo
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method requestSpsFlowInfo {
        in {
            UInt32 txFlowId
        }
        out {
            commonapi.telux.cv2x.Cv2xRadioTypes.SpsFlowInfo spsInfo
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method changeEventFlowInfo {
        in {
            UInt32 txFlowId
            commonapi.telux.cv2x.Cv2xRadioTypes.EventFlowInfo eventInfo
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method requestCapability {
        out {
            commonapi.telux.cv2x.Cv2xRadioTypes.Cv2xRadioCapabilities capabilities
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method requestDataSessionSettings {
        out {
            commonapi.telux.cv2x.Cv2xRadioTypes.DataSessionSettings settings
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method updateSrcL2Info {
        out {
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method updateTrustedUEList {
        in {
            commonapi.telux.cv2x.Cv2xRadioTypes.TrustedUEInfoList infoList
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method getIfaceNameFromIpType {
        in {
            commonapi.telux.cv2x.Cv2xRadioTypes.TrafficIpType ipType
        }
        out {
            String ifaceNameIp
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method createCv2xTcpSocket {
        in {
            commonapi.telux.cv2x.Cv2xRadioTypes.EventFlowInfo eventFlowInfo
            commonapi.telux.cv2x.Cv2xRadioTypes.SocketInfo socketInfo
        }
        out {
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method closeCv2xTcpSocket {
        in {
            UInt32 sockId
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method setGlobalIPInfo {
        in {
            commonapi.telux.cv2x.Cv2xRadioTypes.IPv6AddrType ipv6Addr
        }
        out {
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method setGlobalIPUnicastRoutingInfo {
        in {
            commonapi.telux.cv2x.Cv2xRadioTypes.GlobalIPUnicastRoutingInfo destL2Addr
        }
        out {
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method getCapabilities {
        in {
        }
        out {
            commonapi.telux.cv2x.Cv2xRadioTypes.Cv2xRadioCapabilities capabilities
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    method injectVehicleSpeed {
        in {
            UInt32 speed
        }
        out {
        }
        error commonapi.telux.common.CommonDefines.ErrorCode
    }

    broadcast currentCv2xStatus {
        out {
            commonapi.telux.cv2x.Cv2xRadioTypes.Cv2xStatus status
        }
    }

    broadcast cv2xStatusEx {
        out {
            commonapi.telux.cv2x.Cv2xRadioTypes.Cv2xStatusEx statusEx
        }
    }

    broadcast currentL2Addr {
        out {
            UInt32 newL2Addr
        }
    }

    broadcast currentSpsOffset {
        out {
            Int32 spsId
            commonapi.telux.cv2x.Cv2xRadioTypes.MacDetails details
        }
    }

    broadcast currentCapabilities {
        out {
            commonapi.telux.cv2x.Cv2xRadioTypes.Cv2xRadioCapabilities capabilities
        }
    }

    broadcast macAddrClone {
        out {
            Boolean detected
        }
    }
}
